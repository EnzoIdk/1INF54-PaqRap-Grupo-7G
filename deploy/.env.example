# Copiar a deploy/.env en el servidor y completar. El .env real NO se sube al
# repositorio (esta en .gitignore).
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env

# Contrasena de PostgreSQL. Generar una propia, por ejemplo:
#   openssl rand -hex 20
# Solo se aplica al crear el volumen por primera vez; cambiarla despues exige
# ALTER USER dentro de la base, no basta con editar este archivo.
POSTGRES_PASSWORD=

POSTGRES_DB=paqrap
POSTGRES_USER=paqrap

# Direccion con la que Caddy atiende:
#   :80              -> solo HTTP (sirve por IP o por cualquier nombre)
#   <nombre-dominio> -> HTTPS automatico con Let's Encrypt (requiere que el
#                       nombre resuelva a este servidor y que el puerto 80
#                       sea alcanzable desde Internet)
SITE_ADDRESS=:80

# Memoria de la JVM. El contenedor del backend tiene un tope de 900 MB
# (deploy/docker-compose.prod.yml); el 70 % queda para el heap.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError
